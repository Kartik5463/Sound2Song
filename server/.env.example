PORT=5000
# Free MongoDB Atlas cluster (M0) connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sound2song
AUDIO_SERVICE_URL=http://localhost:8000
# Browser origins allowed to call the API (comma separated)
CLIENT_URL=http://localhost:5173
# Shared secret for the audio service (must match audio-service AUDIO_SERVICE_TOKEN; optional locally)
AUDIO_SERVICE_TOKEN=
# Production only: serve the built React app from this server (single-service hosting)
SERVE_CLIENT=false
# Number of proxies in front of the app (set to 1 on Render/Railway)
TRUST_PROXY=0
# Reuse a saved result for the same video for this many days
CACHE_DAYS=7
