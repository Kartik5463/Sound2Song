PORT=8000
# Where temporary audio files are written (deleted after each request)
TEMP_DIR=./tmp
# Videos longer than this (seconds) are rejected
MAX_DURATION_SECONDS=900
# Length of each audio segment sent for recognition (seconds)
# Shazam listens to 12 s windows, so keep this at 12
SEGMENT_SECONDS=12
MIN_SEGMENT_SECONDS=6
MAX_SEGMENTS=75
# Silence detection threshold and minimum silence length
SILENCE_DB=-40
SILENCE_MIN_SECONDS=1.5
SAMPLE_RATE=16000
MAX_CONCURRENT_JOBS=2
# JavaScript runtime yt-dlp uses for YouTube (node or deno)
YTDLP_JS_RUNTIME=node
# Song recognition. Shazam's free endpoint allows ~3 requests at once, then ~1 every
# 15-20 s per IP address, so only some segments are checked.
RECOGNIZE_INITIAL_PROBES=3
RECOGNIZE_MAX_REQUESTS=8
RECOGNIZE_TIME_BUDGET_SECONDS=90
RECOGNIZE_TIMEOUT_SECONDS=20
SHAZAM_BURST=3
SHAZAM_REFILL_SECONDS=18
SHAZAM_COOLDOWN_SECONDS=30
SHAZAM_MAX_RETRIES=2
